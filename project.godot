config_version=5
[application]
config/name="Core Defense — Лабораторная 3"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.svg"
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
[dotnet]
project/assembly_name="TowerDefense"
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.07, 1)
[input]
move_left={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":68)]
}
move_up={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":87)]
}
move_down={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":83)]
}
fire={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":32), Object(InputEventMouseButton,"button_index":1)]
}
build={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":69)]
}
cancel_build={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":4194305)]
}
tower_1={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":49)]
}
tower_2={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":50)]
}
tower_3={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":51)]
}
pause={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":80)]
}
restart={
"deadzone":0.2,
"events":[Object(InputEventKey,"physical_keycode":82)]
}
